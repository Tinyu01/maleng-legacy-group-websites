# Environment Variables Configuration
# Copy this file to .env.local and fill in your values

# Google Analytics Configuration
# Get your Measurement ID from: https://analytics.google.com
# Format: G-XXXXXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Optional: API Keys (for future expansion)
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_APP_ENV=production

# Email Configuration (for future contact form)
# EMAIL_API_KEY=
# EMAIL_FROM=ceo@malenglegacy.co.za

# Note: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# All other variables are server-side only
